{
  "name": "ashbi-platform",
  "version": "1.0.0",
  "description": "AI-powered client request management system for agencies",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "tsx watch src/index.js",
    "dev:web": "npm --prefix web run dev",
    "dev:worker": "tsx watch --import ./src/tracing.js src/jobs/worker.js",
    "start": "node --import ./src/tracing.js src/index.js",
    "type-check": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "type-check:watch": "tsc --noEmit --watch",
    "build": "npx prisma generate && npm --prefix web run build",
    "build:backend": "npx prisma generate",
    "build:all": "npm run build",
    "build:web": "npm --prefix web run build",
    "preview": "npm --prefix web run preview",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "test": "NODE_ENV=test CI=${CI:-1} find src/tests/unit -name '*.test.js' | xargs node --test",
    "test:integration": "NODE_ENV=test CI=${CI:-1} find src/tests/integration -name '*.test.js' | xargs node --test",
    "test:watch": "NODE_ENV=test CI=${CI:-1} node --test --watch src/tests/unit",
    "test:web": "npm --prefix web test",
    "check:dependencies": "npm ls --all && npm --prefix web ls --all",
    "check:boundaries": "node scripts/check-package-boundaries.mjs",
    "check:frontend-budgets": "node scripts/check-frontend-budgets.mjs --dist web/dist",
    "check:release-gates": "node scripts/check-release-gates.mjs",
    "audit:password-hashes": "node scripts/audit-password-hashes.mjs",
    "audit:uploads": "node scripts/audit-uploads.mjs",
    "quarantine:uploads": "node scripts/audit-uploads.mjs --quarantine",
    "audit:wp-bridge-ownership": "node scripts/audit-wp-bridge-ownership.mjs",
    "test:all": "NODE_ENV=test CI=${CI:-1} find src/tests/unit src/tests/integration -name '*.test.js' | xargs node --test",
    "test:e2e:setup": "bash tests/e2e/setup.sh",
    "test:e2e:teardown": "bash tests/e2e/teardown.sh",
    "test:e2e": "vitest run --config tests/e2e/vitest.config.mjs",
    "test:e2e:watch": "vitest --config tests/e2e/vitest.config.mjs",
    "test:browser": "playwright test",
    "test:public-routes": "playwright test --config playwright.public.config.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:adopt-baseline": "node scripts/adopt-prisma-baseline.mjs",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:push": "prisma db push"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@fastify/compress": "^8.3.1",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/jwt": "^10.0.0",
    "@fastify/multipart": "^10.1.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.2",
    "@fastify/websocket": "^11.0.1",
    "@google/generative-ai": "^0.24.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.219.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "@sentry/node": "^10.62.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.76.6",
    "csv-parser": "^3.2.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.11.2",
    "form-data": "^4.0.6",
    "googleapis": "^171.4.0",
    "handlebars": "^4.7.8",
    "ioredis": "^5.10.1",
    "mailgun.js": "^13.3.0",
    "mailparser": "^3.9.14",
    "pdfkit": "^0.19.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prisma": "7.9.1",
    "socket.io": "^4.8.1",
    "stripe": "^22.1.1",
    "web-push": "^3.6.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.62.0",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.11.10",
    "eslint": "^10.8.0",
    "execa": "^9.5.1",
    "globals": "^17.6.0",
    "pg": "^8.13.0",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "eslint": {
      "minimatch": "3.1.5",
      "brace-expansion": "1.1.18"
    },
    "@eslint/config-array": {
      "minimatch": "3.1.5",
      "brace-expansion": "1.1.18"
    },
    "@eslint/eslintrc": {
      "minimatch": "3.1.5",
      "brace-expansion": "1.1.18"
    },
    "eslint-plugin-react": {
      "minimatch": "3.1.5",
      "brace-expansion": "1.1.18"
    },
    "valibot": "^1.4.2"
  }
}
