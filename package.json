{
  "name": "ashbi-platform",
  "version": "1.0.0",
  "description": "AI-powered client request management system for agencies",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "tsx watch src/index.js",
    "dev:web": "vite",
    "dev:worker": "tsx watch --import ./src/tracing.js src/jobs/worker.js",
    "start": "node --import ./src/tracing.js src/index.js",
    "type-check": "tsc --noEmit",
    "type-check:watch": "tsc --noEmit --watch",
    "build": "npx prisma generate && vite build",
    "build:backend": "npx prisma generate",
    "build:all": "npx prisma generate && vite build",
    "preview": "vite preview",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "test": "NODE_ENV=test CI=${CI:-1} find src/tests/unit -name '*.test.js' | xargs node --test",
    "test:integration": "NODE_ENV=test CI=${CI:-1} find src/tests/integration -name '*.test.js' | xargs node --test",
    "test:watch": "NODE_ENV=test CI=${CI:-1} node --test --watch src/tests/unit",
    "test:all": "NODE_ENV=test CI=${CI:-1} find src/tests/unit src/tests/integration -name '*.test.js' | xargs node --test",
    "test:e2e:setup": "bash tests/e2e/setup.sh",
    "test:e2e:teardown": "bash tests/e2e/teardown.sh",
    "test:e2e": "vitest run --config tests/e2e/vitest.config.mjs",
    "test:e2e:watch": "vitest --config tests/e2e/vitest.config.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:push": "prisma db push"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.0",
    "@fastify/compress": "^8.3.1",
    "@fastify/cookie": "^10.0.1",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/jwt": "^10.0.0",
    "@fastify/multipart": "^10.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^9.1.3",
    "@fastify/websocket": "^11.0.1",
    "@google/generative-ai": "^0.24.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.77.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.219.0",
    "@opentelemetry/sdk-node": "^0.219.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "7.8.0",
    "@radix-ui/react-avatar": "^1.1.1",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.2",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-toast": "^1.2.2",
    "@radix-ui/react-tooltip": "^1.1.3",
    "@sentry/node": "^10.62.0",
    "@tanstack/react-query": "^5.60.2",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.76.6",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "csv-parser": "^3.2.0",
    "date-fns": "^4.1.0",
    "dompurify": "^3.4.11",
    "dotenv": "^16.4.5",
    "fastify": "^5.1.0",
    "form-data": "^4.0.6",
    "googleapis": "^171.4.0",
    "handlebars": "^4.7.8",
    "ioredis": "^5.10.1",
    "lucide-react": "^0.460.0",
    "mailgun.js": "^10.2.2",
    "mailparser": "^3.9.11",
    "pdfkit": "^0.18.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "postcss": "^8.5.14",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-is": "^19.2.6",
    "react-router-dom": "^7.17.0",
    "recharts": "^3.8.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "stripe": "^22.1.1",
    "tailwind-merge": "^2.5.4",
    "tailwindcss": "^3.4.15",
    "tailwindcss-animate": "^1.0.7",
    "vite": "^6.0.1",
    "web-push": "^3.6.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.59.1",
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^26.0.1",
    "@types/pg": "^8.11.10",
    "eslint": "^9.15.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.20",
    "execa": "^9.5.1",
    "globals": "^17.6.0",
    "pg": "^8.13.0",
    "prisma": "7.8.0",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
