{
  "name": "ashbi-platform",
  "version": "1.0.0",
  "description": "AI-powered client request management system for agencies",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "tsx watch src/server.js",
    "dev:web": "npm --prefix web run dev",
    "dev:worker": "tsx watch --import ./src/tracing.js src/jobs/worker.js",
    "start": "npm run start:api",
    "start:api": "node --import ./src/tracing.js src/server.js",
    "start:worker": "node --import ./src/tracing.js src/jobs/worker.js",
    "health:worker": "node scripts/worker-health.mjs",
    "smoke:production-health": "node scripts/smoke-production-health.mjs",
    "type-check": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "type-check:watch": "tsc --noEmit --watch",
    "build": "npx prisma generate && npm --prefix web run build",
    "build:backend": "npx prisma generate",
    "build:all": "npm run build",
    "build:web": "npm --prefix web run build",
    "preview": "npm --prefix web run preview",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "test": "node scripts/run-node-tests.mjs src/tests/unit",
    "test:integration": "node scripts/run-node-tests.mjs src/tests/integration",
    "test:watch": "NODE_ENV=test CI=${CI:-1} node --test --watch src/tests/unit",
    "test:web": "npm --prefix web test",
    "check:dependencies": "npm ls --all && npm --prefix web ls --all",
    "check:boundaries": "node scripts/check-package-boundaries.mjs",
    "check:frontend-budgets": "node scripts/check-frontend-budgets.mjs --dist web/dist",
    "check:release-gates": "node scripts/check-release-gates.mjs",
    "audit:password-hashes": "node scripts/audit-password-hashes.mjs",
    "audit:uploads": "node scripts/audit-uploads.mjs",
    "quarantine:uploads": "node scripts/audit-uploads.mjs --quarantine",
    "audit:wp-bridge-ownership": "node scripts/audit-wp-bridge-ownership.mjs",
    "audit:credential-access": "node scripts/review-credential-access.mjs",
    "rotate:credential-keys": "node scripts/rotate-credential-keys.mjs",
    "drill:credential-rotation": "node scripts/drill-credential-rotation.mjs",
    "check:credential-key-config": "node scripts/check-credential-key-config.mjs",
    "check:sandbox-readiness": "node scripts/check-sandbox-readiness.mjs",
    "check:public-intake-readiness": "node scripts/check-public-intake-readiness.mjs",
    "check:controlled-journey-readiness": "node scripts/check-controlled-journey-readiness.mjs",
    "bootstrap:sandbox-workspace": "node scripts/bootstrap-sandbox-workspace.mjs",
    "prepare:bonsai-cutover-manifest": "node scripts/prepare-bonsai-cutover-manifest.mjs",
    "check:bonsai-cutover": "node scripts/check-bonsai-cutover-readiness.mjs",
    "prepare:unified-launch-manifest": "node scripts/prepare-unified-launch-manifest.mjs",
    "check:unified-launch": "node scripts/check-unified-launch-readiness.mjs",
    "export:growth-cadence-evidence": "node scripts/export-growth-cadence-evidence.mjs",
    "export:controlled-journey-evidence": "node scripts/export-controlled-journey-evidence.mjs",
    "verify:revenue-evidence": "node scripts/verify-revenue-evidence-export.js",
    "reconcile:bonsai-revenue": "node scripts/reconcile-bonsai-revenue.js",
    "reconcile:bonsai-operations": "node scripts/reconcile-bonsai-operations.js",
    "reconcile:bonsai-tasks": "node scripts/reconcile-bonsai-tasks.js",
    "verify:bonsai-task-snapshot": "node scripts/verify-bonsai-task-snapshot.mjs",
    "verify:bonsai-project-snapshot": "node scripts/verify-bonsai-project-snapshot.mjs",
    "verify:bonsai-financial-index": "node scripts/verify-bonsai-financial-index.mjs",
    "verify:notion-operating-snapshot": "node scripts/verify-notion-operating-snapshot.mjs",
    "compare:notion-bonsai-tasks": "node scripts/compare-notion-bonsai-tasks.mjs",
    "prepare:notion-bonsai-task-review": "node scripts/prepare-notion-bonsai-task-review.mjs",
    "prepare:notion-bonsai-project-review": "node scripts/prepare-notion-bonsai-project-review.mjs",
    "prepare:notion-bonsai-native-project-review": "node scripts/prepare-notion-bonsai-native-project-review.mjs",
    "prepare:notion-bonsai-native-project-link-decision": "node scripts/prepare-notion-bonsai-native-project-link-decision.mjs",
    "verify:notion-bonsai-native-project-link-decision": "node scripts/verify-notion-bonsai-native-project-link-decision.mjs",
    "prepare:bonsai-active-project-triage": "node scripts/prepare-bonsai-active-project-triage.mjs",
    "prepare:bonsai-active-project-financial-review": "node scripts/prepare-bonsai-active-project-financial-review.mjs",
    "prepare:notion-bonsai-mapping-decision": "node scripts/prepare-notion-bonsai-mapping-decision.mjs",
    "verify:notion-bonsai-mapping-decision": "node scripts/verify-notion-bonsai-mapping-decision.mjs",
    "prepare:notion-bonsai-owner-decision": "node scripts/prepare-notion-bonsai-owner-decision.mjs",
    "verify:notion-bonsai-owner-decision": "node scripts/verify-notion-bonsai-owner-decision.mjs",
    "test:all": "node scripts/run-node-tests.mjs src/tests/unit src/tests/integration",
    "test:e2e:setup": "bash tests/e2e/setup.sh",
    "test:e2e:teardown": "bash tests/e2e/teardown.sh",
    "test:e2e": "vitest run --config tests/e2e/vitest.config.mjs",
    "test:e2e:watch": "vitest --config tests/e2e/vitest.config.mjs",
    "test:browser": "playwright test",
    "test:public-routes": "playwright test --config playwright.public.config.ts",
    "test:pwa-offline": "playwright test --config playwright.pwa.config.ts",
    "test:lighthouse:mobile": "node -e \"require('fs').rmSync('.lighthouseci/mobile',{recursive:true,force:true})\" && lhci autorun --config=lighthouserc.mobile.cjs",
    "test:lighthouse:desktop": "node -e \"require('fs').rmSync('.lighthouseci/desktop',{recursive:true,force:true})\" && lhci autorun --config=lighthouserc.desktop.cjs",
    "test:lighthouse": "npm run test:lighthouse:mobile && npm run test:lighthouse:desktop",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:adopt-baseline": "node scripts/adopt-prisma-baseline.mjs",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:push": "prisma db push"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@fastify/compress": "^8.3.1",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/jwt": "^10.0.0",
    "@fastify/multipart": "^10.1.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.2",
    "@fastify/websocket": "^11.0.1",
    "@google/generative-ai": "^0.24.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.219.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "@sentry/node": "^10.62.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.76.6",
    "csv-parser": "^3.2.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.11.2",
    "form-data": "^4.0.6",
    "googleapis": "^171.4.0",
    "handlebars": "^4.7.8",
    "ioredis": "^5.10.1",
    "mailgun.js": "^13.3.0",
    "mailparser": "^3.9.14",
    "pdfkit": "^0.19.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prisma": "7.9.1",
    "socket.io": "^4.8.1",
    "stripe": "^22.1.1",
    "web-push": "^3.6.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.39.4",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.62.0",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.11.10",
    "eslint": "^10.8.0",
    "execa": "^9.5.1",
    "globals": "^17.6.0",
    "pg": "^8.13.0",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "eslint": {
      "minimatch": "3.1.5",
      "brace-expansion": "1.1.18"
    },
    "@eslint/config-array": {
      "minimatch": "3.1.5",
      "brace-expansion": "1.1.18"
    },
    "@eslint/eslintrc": {
      "minimatch": "3.1.5",
      "brace-expansion": "1.1.18"
    },
    "eslint-plugin-react": {
      "minimatch": "3.1.5",
      "brace-expansion": "1.1.18"
    },
    "tmp": "^0.2.6",
    "uuid": "^11.1.1",
    "valibot": "^1.4.2"
  }
}
