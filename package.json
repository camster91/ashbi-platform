{
  "name": "ashbi-platform",
  "version": "1.0.0",
  "description": "Agency workspace with scoped HTTP API and MCP tools",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "mcp": "node scripts/workspace-mcp.mjs",
    "dev": "tsx watch src/server.js",
    "dev:web": "npm --prefix web run dev",
    "dev:worker": "tsx watch --import ./src/tracing.js src/jobs/worker.js",
    "start": "npm run start:api",
    "start:api": "node --import ./src/tracing.js src/server.js",
    "start:worker": "node --import ./src/tracing.js src/jobs/worker.js",
    "health:worker": "node scripts/worker-health.mjs",
    "smoke:production-health": "node scripts/smoke-production-health.mjs",
    "type-check": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "type-check:watch": "tsc --noEmit --watch",
    "build": "npx prisma generate && npm --prefix web run build",
    "build:backend": "npx prisma generate",
    "build:all": "npm run build",
    "build:web": "npm --prefix web run build",
    "preview": "npm --prefix web run preview",
    "lint": "eslint src/ --max-warnings 0",
    "lint:fix": "eslint src/ --fix",
    "test": "node scripts/run-node-tests.mjs src/tests/unit src/tests/ai-eval",
    "test:core": "npm run test:core:api && npm run test:core:web",
    "test:core:api": "node scripts/run-node-tests.mjs src/tests/unit/revocable-sessions.test.js src/tests/unit/client-portal-principal.test.js src/tests/unit/client-invite-tenant.test.js src/tests/unit/tenant-proxy-bypasses.test.js src/tests/unit/time-tracking-integrity.test.js src/tests/unit/invoice-draft-atomicity.test.js src/tests/unit/unbilled-invoice.test.js src/tests/unit/client-portal-invoices.test.js src/tests/unit/file-upload-policy.test.js src/tests/unit/note-concurrency.test.js",
    "test:core:web": "npm --prefix web test -- src/tests/Login.mfa.test.jsx src/tests/Clients.contact.test.jsx src/tests/Projects.board.test.jsx src/tests/TaskKanban.test.jsx src/tests/ProjectFiles.upload.test.jsx src/tests/DocumentSaveRecovery.test.jsx",
    "test:ai-eval": "node scripts/run-node-tests.mjs src/tests/ai-eval",
    "test:integration": "node scripts/run-node-tests.mjs src/tests/integration",
    "test:watch": "NODE_ENV=test CI=${CI:-1} node --import ./scripts/test-stdout-guard.mjs --test --watch src/tests/unit",
    "test:web": "npm --prefix web test",
    "check:dependencies": "npm ls --all && npm --prefix web ls --all",
    "check:boundaries": "node scripts/check-package-boundaries.mjs",
    "check:frontend-budgets": "node scripts/check-frontend-budgets.mjs --dist web/dist",
    "check:release-gates": "node scripts/check-release-gates.mjs",
    "check:secrets": "node scripts/check-secrets.mjs .",
    "check:schema-drift": "prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --exit-code",
    "docs:data-dictionary": "node scripts/generate-data-dictionary.mjs",
    "check:data-dictionary": "node scripts/generate-data-dictionary.mjs --check",
    "docs:openapi": "node scripts/generate-openapi.mjs",
    "check:openapi": "node scripts/generate-openapi.mjs --check",
    "audit:password-hashes": "node scripts/audit-password-hashes.mjs",
    "audit:uploads": "node scripts/audit-uploads.mjs",
    "quarantine:uploads": "node scripts/audit-uploads.mjs --quarantine",
    "audit:credential-access": "node scripts/review-credential-access.mjs",
    "rotate:credential-keys": "node scripts/rotate-credential-keys.mjs",
    "drill:credential-rotation": "node scripts/drill-credential-rotation.mjs",
    "check:credential-key-config": "node scripts/check-credential-key-config.mjs",
    "test:all": "node scripts/run-node-tests.mjs src/tests/unit src/tests/ai-eval src/tests/integration",
    "test:e2e:setup": "bash tests/e2e/setup.sh",
    "test:e2e:teardown": "bash tests/e2e/teardown.sh",
    "test:e2e": "vitest run --config tests/e2e/vitest.config.mjs",
    "test:e2e:watch": "vitest --config tests/e2e/vitest.config.mjs",
    "test:e2e:journeys": "playwright test --config playwright.stack.config.ts",
    "test:browser": "playwright test",
    "test:public-routes": "playwright test --config playwright.public.config.ts",
    "test:pwa-offline": "playwright test --config playwright.pwa.config.ts",
    "test:visual": "playwright test --config playwright.visual.config.ts",
    "test:visual:update": "playwright test --config playwright.visual.config.ts --update-snapshots",
    "test:lighthouse:mobile": "node -e \"require('fs').rmSync('.lighthouseci/mobile',{recursive:true,force:true})\" && lhci autorun --config=lighthouserc.mobile.cjs",
    "test:lighthouse:desktop": "node -e \"require('fs').rmSync('.lighthouseci/desktop',{recursive:true,force:true})\" && lhci autorun --config=lighthouserc.desktop.cjs",
    "test:lighthouse": "npm run test:lighthouse:mobile && npm run test:lighthouse:desktop",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:adopt-baseline": "node scripts/adopt-prisma-baseline.mjs",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:push": "prisma db push",
    "verify:quick": "npm run check:boundaries && npm run type-check && npm run lint && npm --prefix web run lint && npm test && npm --prefix web test",
    "verify": "npm run verify:quick && npm run test:integration && npm run build",
    "verify:browser": "npm run test:browser && npm run test:public-routes && npm run test:pwa-offline",
    "verify:release": "npm run verify && npm run test:lighthouse && npm run check:release-gates"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@fastify/compress": "^9.2.2",
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/jwt": "^10.2.5",
    "@fastify/multipart": "^10.1.4",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.6",
    "@google/genai": "^2.30.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.81.2",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@sentry/node": "^11.8.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@socket.io/redis-emitter": "^5.1.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^6.3.16",
    "csv-parser": "^3.2.1",
    "dotenv": "^18.0.8",
    "fastify": "^5.12.7",
    "form-data": "^4.0.6",
    "googleapis": "^186.0.0",
    "handlebars": "^4.7.10",
    "ioredis": "^6.0.0",
    "mailgun.js": "^14.1.0",
    "mailparser": "^3.9.40",
    "pdfkit": "^0.20.2",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "playwright-core": "^1.64.1",
    "prisma": "7.10.1",
    "socket.io": "^4.8.4",
    "stripe": "^23.0.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.1",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "pg": "^8.23.1",
    "proxy-agent": "8.0.2",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=24.22.0"
  },
  "overrides": {
    "tmp": "^0.2.6",
    "uuid": "^11.1.1",
    "valibot": "^1.4.2",
    "deepmerge-ts": "^8.0.2",
    "mysql2": "^3.24.4",
    "nanoid": "^3.3.18",
    "html-to-text": "^10.0.1",
    "qs": "^6.17.0",
    "@puppeteer/browsers": "^3.2.3",
    "basic-ftp": "^6.2.3"
  }
}
