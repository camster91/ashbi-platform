# Force npm to use only the public registry.
# Prevents dependabot from looking for `npm.pkg.github.com` config and
# failing weekly with `private_registry_config_not_found`. This repo does
# not consume any packages from GitHub Packages — the warning was a
# false positive from dependabot's default behavior of probing the
# host's package registry.
registry=https://registry.npmjs.org/