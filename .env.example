# Database (PostgreSQL with pgvector required)
# PRODUCTION: set via GH secret `PRODUCTION_DATABASE_URL` and rendered into
# /opt/ashbi-platform/.env by deploy-coolify.yml. Never commit a real
# password to the repo. The local .env is gitignored.
# The CI gate (.github/workflows/check-secrets.yml) scans this file and
# src/ for hardcoded `postgresql://user:password@host` patterns and fails
# the build if any are found.
DATABASE_URL=postgresql://ashbihub:CHANGE_ME_LOCAL_DEV_ONLY@localhost:5432/ashbihub

# Server
PORT=3000
NODE_ENV=development
CORS_ORIGIN=https://hub.ashbi.ca

# Public ashbi.ca inquiry API (/api/client-acquisition). Intake stays disabled
# (config reports enabled:false, intake returns 503) until ALL five are set.
# See docs/client-acquisition-intake.md.
CLIENT_ACQUISITION_ORGANIZATION_ID=
CLIENT_ACQUISITION_OWNER_ID=
CLIENT_ACQUISITION_PRIVACY_VERSION=
CLIENT_ACQUISITION_SERVICE_LINES=
CLIENT_ACQUISITION_ALLOWED_ORIGINS=

# Auth
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=7d
# Required for first admin registration — set a strong random value
ADMIN_INVITE_TOKEN=your-admin-invite-token

# AI
ANTHROPIC_API_KEY=your-anthropic-api-key
GEMINI_API_KEY=your-gemini-api-key
# AI_PROVIDER: 'ollama' (default), 'claude', or 'gemini'
AI_PROVIDER=ollama
OLLAMA_API_KEY=your-ollama-cloud-api-key
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:31b
# Comma-separated user ids of ADMIN users allowed to switch the AI provider or
# model at runtime. That setting is shared by every organization on this
# deployment, so leave this empty unless you operate the whole deployment.
# A runtime switch applies to the API process until restart; the worker and
# new deploys keep AI_PROVIDER / OLLAMA_MODEL.
PLATFORM_OPERATOR_USER_IDS=
# Deployment-wide AI kill switch (docs/ai-byok.md). true: every AI call, for
# every organization, fails with AI_DISABLED before any provider is contacted.
AI_DISABLED=false
# Prices for organization bring-your-own-key usage estimates and monthly
# budgets: JSON keyed by model id, US cents per 1M tokens, e.g.
# {"example-model":{"input":15,"output":60}}. Unpriced models are metered
# with no cost and do not count toward budgets.
AI_MODEL_PRICES=
# Organization that receives bookings from the public /portal/book page.
# Unset: booking works only while exactly one organization exists.
PUBLIC_BOOKING_ORGANIZATION_ID=
# Kilo AI Gateway
KILO_API_KEY=your-kilo-api-key
KILO_API_BASE=https://api.kilo.ai/api/gateway/
KILO_MODEL=anthropic/claude-haiku-4-5

# Redis (for BullMQ queues)
REDIS_URL=redis://localhost:6379

# Webhook
WEBHOOK_SECRET=your-webhook-secret

# Credentials vault encryption key
CREDENTIALS_KEY=your-credentials-encryption-key
# Rotation-safe keyring. Keep the legacy key during staged migration, add the
# new version, then switch the active version. Remove old keys only after the
# audited rotation and rollback window are complete.
CREDENTIALS_KEYRING={"legacy":"existing-key","v2":"new-key-from-secret-store"}
CREDENTIALS_ACTIVE_KEY_VERSION=legacy
# Named person or security rotation accountable for key custody and emergency rotation.
CREDENTIALS_KEY_OWNER=

# Mailgun
MAILGUN_API_KEY=your-mailgun-api-key
MAILGUN_DOMAIN=ashbi.ca
MAILGUN_SIGNING_KEY=your-mailgun-signing-key
# HTTP webhook signing key for delivery events (Mailgun > Sending > Webhooks).
# Point the delivered / permanent_fail / complained webhooks at
# https://<host>/api/mailgun/events. Requests are rejected unless the HMAC
# signature matches and the timestamp is under 15 minutes old.
MAILGUN_WEBHOOK_SIGNING_KEY=your-mailgun-webhook-signing-key
DISCORD_AGENCY_HUB_WEBHOOK_URL=
DISCORD_DEPLOYMENTS_WEBHOOK_URL=
DISCORD_ALERTS_WEBHOOK_URL=
DISCORD_CAM_WEBHOOK_URL=

# Stripe
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# Shopify
SHOPIFY_CLIENT_ID=your-shopify-client-id
SHOPIFY_CLIENT_SECRET=your-shopify-client-secret

# Bot API
BOT_SECRET=your-bot-secret
# Organization ID the bot API scopes to (required for multi-tenant isolation)
BOT_ORGANIZATION_ID=

# Notification webhook
NOTIFICATION_WEBHOOK_URL=

# App URLs
APP_URL=https://hub.ashbi.ca
HUB_URL=https://hub.ashbi.ca
PORTAL_BASE_URL=https://hub.ashbi.ca

# Outreach Agent — Hunter.io
HUNTER_API_KEY=your-hunter-api-key

# Outreach Scheduler Agent
OUTREACH_SCHEDULER_API_KEY=your-outreach-scheduler-api-key

# Referral Engine Agent
REFERRAL_ENGINE_API_KEY=your-referral-engine-api-key

# Hub-Hermes Bridge
HERMES_WEBHOOK_SECRET=your-hermes-webhook-secret

# Observability — Sentry error tracking (optional; leave blank to disable)
SENTRY_DSN=
# Optional OTLP HTTP trace endpoint. No exporter starts when unset.
OTLP_ENDPOINT=
# Named person or rotation accountable for production alerts.
OBSERVABILITY_OWNER=
# Provider-neutral endpoint for scrubbed final-failure alerts.
NOTIFICATION_WEBHOOK_URL=

# Slack Events API signing secret. This protects inbound Slack callbacks at
# /api/slack/events.
# Create it in Slack's app configuration; never commit a real value.
SLACK_SIGNING_SECRET=
# Slack OAuth v2 application credentials. Set the redirect URI in Slack to
# https://hub.ashbi.ca/api/slack/oauth/callback (or the deployed equivalent).
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=https://hub.ashbi.ca/api/slack/oauth/callback
# Slack bot tokens are entered through the authenticated organization-admin
# setup endpoint and encrypted with CREDENTIALS_KEY. Do not add bot tokens here.

# Google Calendar OAuth. Set the redirect URI in the Google Cloud OAuth client
# to https://hub.ashbi.ca/api/google-calendar/oauth/callback (or deployment
# equivalent). Individual refresh tokens are encrypted in Ashbi's database.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=https://hub.ashbi.ca/api/google-calendar/oauth/callback

# Command Center Integrations
GITHUB_TOKEN=your-github-personal-access-token
GITHUB_ORG=camster91
COOLIFY_URL=https://coolify.example.com
COOLIFY_TOKEN=your-coolify-api-token
HOSTINGER_ASHBI_SITES=ashbi.ca,ashbidesign.com
HOSTINGER_INFLUENCER_STORES=store1.com,store2.com

# OpenClaw
OPENCLAW_URL=http://localhost:3000
OPENCLAW_API_KEY=your-openclaw-api-key

# Web Push (VAPID keys - generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Frontend
VITE_API_URL=
# Optional support guidance on the fatal error screen (http(s) help/status page
# and/or support mailbox). When unset, users are told to contact their
# administrator and quote the error reference.
VITE_SUPPORT_URL=
VITE_SUPPORT_EMAIL=
ADMIN_SEED_PASSWORD=


# WebRTC project calls: JSON array of RTCIceServer objects. Add a TURN relay so
# calls connect across restrictive NATs, e.g.
# WEBRTC_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turns:turn.example.com:5349","username":"user","credential":"secret"}]
WEBRTC_ICE_SERVERS=
