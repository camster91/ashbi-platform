# Database (PostgreSQL with pgvector required)
# PRODUCTION: set via GH secret `PRODUCTION_DATABASE_URL` and rendered into
# /opt/ashbi-platform/.env by deploy-coolify.yml. Never commit a real
# password to the repo. The local .env is gitignored.
# The CI gate (.github/workflows/check-secrets.yml) scans this file and
# src/ for hardcoded `postgresql://user:password@host` patterns and fails
# the build if any are found.
DATABASE_URL=postgresql://ashbihub:CHANGE_ME_LOCAL_DEV_ONLY@localhost:5432/ashbihub

# Server
PORT=3000
NODE_ENV=development
CORS_ORIGIN=https://hub.ashbi.ca

# Auth
JWT_SECRET=your-secret-key-change-in-production
# Required for first admin registration — set a strong random value
ADMIN_INVITE_TOKEN=your-admin-invite-token

# AI
ANTHROPIC_API_KEY=your-anthropic-api-key
GEMINI_API_KEY=your-gemini-api-key
# AI_PROVIDER: 'ollama' (default), 'claude', or 'gemini'
AI_PROVIDER=ollama
OLLAMA_API_KEY=your-ollama-cloud-api-key
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:31b
# Kilo AI Gateway
KILO_API_KEY=your-kilo-api-key
KILO_API_BASE=https://api.kilo.ai/api/gateway/
KILO_MODEL=anthropic/claude-haiku-4-5

# Redis (for BullMQ queues)
REDIS_URL=redis://localhost:6379

# Webhook
WEBHOOK_SECRET=your-webhook-secret

# Credentials vault encryption key
CREDENTIALS_KEY=your-credentials-encryption-key

# Mailgun
MAILGUN_API_KEY=your-mailgun-api-key
MAILGUN_DOMAIN=ashbi.ca
MAILGUN_SIGNING_KEY=your-mailgun-signing-key
DISCORD_AGENCY_HUB_WEBHOOK_URL=
DISCORD_DEPLOYMENTS_WEBHOOK_URL=
DISCORD_ALERTS_WEBHOOK_URL=
DISCORD_CAM_WEBHOOK_URL=

# Stripe
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# Shopify
SHOPIFY_CLIENT_ID=your-shopify-client-id
SHOPIFY_CLIENT_SECRET=your-shopify-client-secret

# Bot API
BOT_SECRET=your-bot-secret
# Organization ID the bot API scopes to (required for multi-tenant isolation)
BOT_ORGANIZATION_ID=

# Notification webhook
NOTIFICATION_WEBHOOK_URL=

# App URLs
APP_URL=https://hub.ashbi.ca
HUB_URL=https://hub.ashbi.ca
PORTAL_BASE_URL=https://hub.ashbi.ca

# Outreach Agent — Hunter.io
HUNTER_API_KEY=your-hunter-api-key

# Outreach Scheduler Agent
OUTREACH_SCHEDULER_API_KEY=your-outreach-scheduler-api-key

# Referral Engine Agent
REFERRAL_ENGINE_API_KEY=your-referral-engine-api-key

# Hub-Hermes Bridge
HERMES_WEBHOOK_SECRET=your-hermes-webhook-secret

# Observability — Sentry error tracking (optional; leave blank to disable)
SENTRY_DSN=

# Blog Agent — WordPress publishing
ASHBI_WP_URL=https://ashbi.ca
ASHBI_WP_USER=your-wordpress-username
ASHBI_WP_APP_PASSWORD=your-wordpress-app-password

# WP Bridge — shared secret used by the camster91/ashbi-agency-wp-bridge
# plugin to authenticate against /api/wp-bridge/* endpoints.
WP_BRIDGE_SECRET=your-wp-bridge-shared-secret

# Slack incoming webhook for the WP fleet daily digest (Plan 6).
# Leave unset to disable the 09:00 ET scheduled digest; the manual
# POST /api/wp-bridge/fleet/digest endpoint will return 503 if missing.
SLACK_WEBHOOK_URL=

# Command Center Integrations
GITHUB_TOKEN=your-github-personal-access-token
GITHUB_ORG=camster91
COOLIFY_URL=https://coolify.example.com
COOLIFY_TOKEN=your-coolify-api-token
HOSTINGER_ASHBI_SITES=ashbi.ca,ashbidesign.com
HOSTINGER_INFLUENCER_STORES=store1.com,store2.com

# OpenClaw
OPENCLAW_URL=http://localhost:3000
OPENCLAW_API_KEY=your-openclaw-api-key

# Web Push (VAPID keys - generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Frontend
VITE_API_URL=
ADMIN_SEED_PASSWORD=

# WP Bridge — shared HMAC secret with the WordPress plugin. The plugin
# signs every request body with HMAC-SHA256 over (timestamp + rawBody)
# using this secret. MUST be replaced before production — the placeholder
# value below is rejected at startup by src/config/env.js.
WP_BRIDGE_SECRET=your-wp-bridge-shared-secret
