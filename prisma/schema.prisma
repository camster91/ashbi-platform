// Agency Hub Database Schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

// ==================== TENANCY ====================

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logo      String?
  plan      String   @default("FREE") // FREE, PRO, ENTERPRISE
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  users                     User[]
  clients                   Client[]
  projects                  Project[]
  formDrafts                FormDraft[]
  attachments               Attachment[]
  wpSites                   WPSite[]
  wpBackups                 WPBackup[]
  wpReports                 WPReport[]
  wpAlerts                  WPAlert[]
  wpFleetOps                WPFleetOp[]
  wpMagicLoginLogs          WPMagicLoginLog[]
  wpBridgeNonces            WPBridgeNonce[]
  supportHourEntries        SupportHourEntry[]
  integrations              Integration[]
  trashedItems              TrashedItem[]
  assignmentRules           AssignmentRule[]
  templates                 Template[]
  unmatchedEmails           UnmatchedEmail[]
  lineItemTemplates         LineItemTemplate[]
  weeklyDigests             WeeklyDigest[]
  taskTemplates             TaskTemplate[]
  outreachSequences         OutreachSequence[]
  emailTriageItems          EmailTriageItem[]
  aiContexts                AiContext[]
  ashConversations          AshConversation[]
  projectTemplates          ProjectTemplate[]
  brandSettings             BrandSettings[]
  pipelineStages            PipelineStage[]
  promptVersions            PromptVersion[]
  credentials               Credential[]
  credentialAudits          CredentialAccessAudit[]
  onboardingProgress        OnboardingProgress[]
  slackInstallations        SlackInstallation[]
  slackChannelMappings      SlackChannelMapping[]
  slackEventReceipts        SlackEventReceipt[]
  googleCalendarConnections GoogleCalendarConnection[]
  notionImportRecords       NotionImportRecord[]
  operatingSourceRecords    OperatingSourceRecord[]
  migrationReviewPackets    MigrationReviewPacket[]
  migrationReviewDecisions  MigrationReviewDecision[]
  aiBridgeActions           AiBridgeAction[]
  leads                     Lead[]
  leadEvents                LeadEvent[]
  expenses                  Expense[]

  @@map("organizations")
}

model User {
  id                  String       @id @default(cuid())
  organizationId      String // Set for all users to support multi-tenancy
  organization        Organization @relation(fields: [organizationId], references: [id])
  email               String       @unique
  name                String
  password            String
  role                String       @default("TEAM") // ADMIN, TEAM, CLIENT, or BOT
  clientId            String? // Set for CLIENT role users
  skills              String       @default("[]") // JSON array of skills
  capacity            Int          @default(100) // Percentage available
  isActive            Boolean      @default(true)
  sessionVersion      Int          @default(0) // Increment to revoke every previously issued user session
  hourlyRate          Float?       @default(50)
  resetToken          String?
  resetTokenExpiresAt DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  // Relations
  assignedThreads          Thread[]                  @relation("AssignedTo")
  assignedTasks            Task[]                    @relation("TaskAssignee")
  draftedResponses         Response[]                @relation("DraftedBy")
  approvedResponses        Response[]                @relation("ApprovedBy")
  notifications            Notification[]
  internalNotes            InternalNote[]
  chatMessages             ChatMessage[]             @relation("ChatAuthor")
  chatReactions            ChatReaction[]
  notes                    Note[]                    @relation("NoteAuthor")
  timeEntries              TimeEntry[]
  attachments              Attachment[]
  activities               Activity[]
  taskComments             TaskComment[]             @relation("CommentAuthor")
  createdEvents            CalendarEvent[]           @relation("EventCreator")
  eventAttendees           EventAttendee[]
  proposals                Proposal[]                @relation("ProposalCreator")
  contracts                Contract[]                @relation("ContractCreator")
  invoices                 Invoice[]                 @relation("InvoiceCreator")
  pushSubscriptions        PushSubscription[]
  snippets                 Snippet[]
  proposalVersions         ProposalVersion[]
  timeSessions             TimeSession[]
  apiKeys                  ApiKey[]
  formDrafts               FormDraft[]
  onboardingProgress       OnboardingProgress?
  googleCalendarConnection GoogleCalendarConnection?
  aiBridgeActions          AiBridgeAction[]
  ownedLeads               Lead[]                    @relation("LeadAccountOwner")

  @@index([organizationId])
  @@map("users")
}

model OnboardingProgress {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String       @unique
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleSnapshot   String
  skippedTaskIds Json         @default("[]")
  startedAt      DateTime?
  dismissedAt    DateTime?
  completedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, userId])
  @@map("onboarding_progress")
}

model FormDraft {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  entity         String
  entityId       String
  data           Json
  revision       Int          @default(1)
  baseUpdatedAt  DateTime?
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([userId, entity, entityId])
  @@index([organizationId, userId])
  @@index([expiresAt])
  @@map("form_drafts")
}

model Client {
  id                  String       @id @default(cuid())
  organizationId      String
  organization        Organization @relation(fields: [organizationId], references: [id])
  name                String
  email               String?
  domain              String?      @unique
  status              String       @default("ACTIVE") // ACTIVE, PAUSED, CHURNED
  communicationPrefs  String       @default("{}") // JSON: tone, frequency, etc.
  satisfactionSignals String       @default("{}") // JSON: sentiment trends
  slaOverrides        String? // JSON: custom SLA rules
  knowledgeBase       String       @default("[]") // JSON: brand guidelines, specs, etc.

  // Bonsai migration fields
  bonsaiClientId     String? // Original Bonsai client ID
  tier               String    @default("T3") // T1 | T2 | T3
  contactPerson      String?
  phone              String?
  address            String?
  city               String?
  provinceState      String?
  postalCode         String?
  country            String    @default("US")
  serviceType        String?
  relationshipStatus String    @default("ACTIVE") // ACTIVE | ARCHIVED | LEAD | CHURNED
  totalRevenueUsd    Float     @default(0)
  totalRevenueCad    Float     @default(0)
  lastInvoiceDate    DateTime?
  lastInvoiceStatus  String?
  paymentStatus      String?
  clientNotes        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  // Soft delete
  deletedAt          DateTime?

  // Relations
  contacts         Contact[]
  projects         Project[]
  threads          Thread[]
  retainerPlan     RetainerPlan?
  reports          Report[]
  proposals        Proposal[]
  contracts        Contract[]
  invoices         Invoice[]
  credentials      Credential[]
  aiTeamMessages   AiTeamMessage[]
  expenses         Expense[]
  revenueSnapshots RevenueSnapshot[]
  emailMappings    ClientEmailMapping[]
  intakeForms      IntakeForm[]
  pipelineDeals    PipelineDeal[]
  creativeBriefs   CreativeBrief[]
  assets           Asset[]
  clientEmbeddings ClientEmbedding[]
  invitations      ClientInvitation[]
  wpSites          WPSite[]             @relation("WPSiteClient")
  estimates        Estimate[]
  rateCards        RateCard[]
  convertedLeads   Lead[]               @relation("LeadConvertedClient")

  @@index([status])
  @@index([organizationId])
  @@map("clients")
}

model Contact {
  id        String   @id @default(cuid())
  email     String
  name      String
  role      String?
  isPrimary Boolean  @default(false)
  clientId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([email, clientId])
  @@map("contacts")
}

model Project {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  description    String?
  status         String       @default("STARTING_UP") // STARTING_UP, DESIGN_DEV, ADDING_CONTENT, FINALIZING, LAUNCHED, ON_HOLD, CANCELLED
  health         String       @default("ON_TRACK") // ON_TRACK, NEEDS_ATTENTION, AT_RISK
  healthScore    Int          @default(100)
  healthHistory  Json? // Array of {health, score, timestamp} for historical tracking
  aiSummary      String? // AI-generated current status summary
  aiPlan         String? // JSON: AI-generated task plan
  risks          String       @default("[]") // JSON: identified risks
  defaultOwnerId String?
  clientId       String
  sourceContractId String? @unique
  viewToken      String?      @unique @default(cuid())

  // Bonsai migration fields
  bonsaiProjectId String?
  serviceType     String? // branding | web_design | ecommerce | seo | maintenance
  budget          Float? // Fixed-price contract value
  hourlyBudget    Float? // Max billable hours budget
  startDate       DateTime?
  endDate         DateTime?
  completedAt     DateTime?
  isRetainer      Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  // Soft delete
  deletedAt       DateTime?

  // Autosave draft
  draftData String? // JSON of unsaved form data

  // Relations
  client               Client                 @relation(fields: [clientId], references: [id], onDelete: Cascade)
  sourceContract       Contract?               @relation("ContractProject", fields: [sourceContractId], references: [id], onDelete: SetNull)
  threads              Thread[]
  tasks                Task[]
  chatMessages         ChatMessage[]
  notes                Note[]
  milestones           Milestone[]
  timeEntries          TimeEntry[]
  activities           Activity[]
  calendarEvents       CalendarEvent[]
  revisionRounds       RevisionRound[]
  proposals            Proposal[]
  credentials          Credential[]
  aiTeamMessages       AiTeamMessage[]
  expenses             Expense[]
  approvals            Approval[]
  communications       ProjectCommunication[]
  context              ProjectContext?
  creativeBriefs       CreativeBrief[]
  timeSessions         TimeSession[]
  wpSite               WPSite?
  slackChannelMappings SlackChannelMapping[]
  notionImportRecords  NotionImportRecord[]

  @@index([clientId])
  @@index([status])
  @@index([organizationId])
  @@map("projects")
}

model Task {
  id          String  @id @default(cuid())
  title       String
  description String? // Brief description/summary
  content     String? @default("[]") // JSON: Block-based rich content (Notion-like)
  status      String  @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED, BLOCKED
  priority    String  @default("NORMAL") // CRITICAL, HIGH, NORMAL, LOW
  category    String  @default("UPCOMING") // IMMEDIATE, THIS_WEEK, UPCOMING, WAITING_CLIENT, WAITING_US
  tags        String  @default("[]") // JSON array of tags

  // Notion-like page properties
  isPage     Boolean @default(false) // Treat as a page with subpages
  icon       String? // Emoji or icon URL
  coverImage String? // Cover image URL
  properties String  @default("{}") // JSON: Custom properties/fields

  // Hierarchy
  parentId String? // For subpages/subtasks

  estimatedTime  String?
  startDate      DateTime?
  dueDate        DateTime?
  completedAt    DateTime?
  sourceThreadId String?
  growthReviewKey String?  @unique
  blockedBy      String?
  aiGenerated    Boolean   @default(false)
  position       Int       @default(0) // For Kanban board ordering
  projectId      String
  assigneeId     String?
  milestoneId    String?
  dependsOnId    String? // Task dependency — this task depends on another
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  // Soft delete
  deletedAt      DateTime?

  // Relations
  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee     User?         @relation("TaskAssignee", fields: [assigneeId], references: [id])
  milestone    Milestone?    @relation("MilestoneTasks", fields: [milestoneId], references: [id])
  comments     TaskComment[]
  timeEntries  TimeEntry[]
  timeSessions TimeSession[]

  // Self-relation for subpages/subtasks
  parent   Task?  @relation("TaskSubpages", fields: [parentId], references: [id], onDelete: Cascade)
  subpages Task[] @relation("TaskSubpages")

  // Task dependency relation
  dependsOn    Task?  @relation("TaskDependency", fields: [dependsOnId], references: [id])
  blockedTasks Task[] @relation("TaskDependency")

  @@index([parentId])
  @@index([projectId, parentId])
  @@index([status])
  @@index([priority])
  @@index([dueDate])
  @@index([dependsOnId])
  @@index([assigneeId])
  @@index([projectId, status])
  @@map("tasks")
}

model Thread {
  id              String    @id @default(cuid())
  subject         String
  status          String    @default("OPEN") // OPEN, AWAITING_RESPONSE, RESOLVED, SNOOZED
  priority        String    @default("NORMAL") // CRITICAL, HIGH, NORMAL, LOW
  intent          String? // AI-classified intent
  sentiment       String? // AI-detected sentiment
  urgencyReason   String?
  lastActivityAt  DateTime  @default(now())
  snoozedUntil    DateTime?
  slaDeadline     DateTime?
  slaBreached     Boolean   @default(false)
  aiAnalysis      String? // JSON: full AI analysis result
  matchConfidence Float     @default(0)
  matchReason     String?
  needsTriage     Boolean   @default(false)
  clientId        String?
  projectId       String?
  assignedToId    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  client        Client?        @relation(fields: [clientId], references: [id])
  project       Project?       @relation(fields: [projectId], references: [id])
  assignedTo    User?          @relation("AssignedTo", fields: [assignedToId], references: [id])
  messages      Message[]
  responses     Response[]
  internalNotes InternalNote[]

  @@index([clientId])
  @@index([projectId])
  @@index([status])
  @@index([assignedToId])
  @@index([status, assignedToId])
  @@index([createdAt])
  @@map("threads")
}

model Message {
  id          String    @id @default(cuid())
  direction   String // INBOUND or OUTBOUND
  senderEmail String
  senderName  String?
  subject     String?
  bodyText    String
  bodyHtml    String?
  rawEmail    String? // Original email content preserved
  headers     String? // JSON: email headers
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  aiExtracted String? // JSON: AI-extracted data
  threadId    String
  createdAt   DateTime  @default(now())

  // Relations
  thread Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId])
  @@index([receivedAt])
  @@map("messages")
}

model InternalNote {
  id        String   @id @default(cuid())
  content   String
  threadId  String
  authorId  String
  createdAt DateTime @default(now())

  // Relations
  thread Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id])

  @@map("internal_notes")
}

model Response {
  id              String    @id @default(cuid())
  status          String    @default("DRAFT") // DRAFT, PENDING_APPROVAL, APPROVED, REJECTED, SENT
  subject         String
  body            String
  tone            String?
  aiGenerated     Boolean   @default(false)
  aiOptions       String? // JSON: alternative AI drafts
  rejectionReason String?
  approvedAt      DateTime?
  sentAt          DateTime?
  threadId        String
  draftedById     String
  approvedById    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  thread     Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  draftedBy  User   @relation("DraftedBy", fields: [draftedById], references: [id])
  approvedBy User?  @relation("ApprovedBy", fields: [approvedById], references: [id])

  @@index([status])
  @@index([createdAt])
  @@map("responses")
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // project.update, invoice.created, invoice.overdue, invoice.paid, proposal.sent, proposal.approved, proposal.declined, contract.signed, message.new, task.assigned, task.completed
  title     String
  message   String
  data      Json?
  read      Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, read])
  @@index([userId, createdAt])
  @@map("notifications")
}

model AssignmentRule {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  type           String // SKILL, CLIENT, PROJECT, LOAD_BALANCE
  conditions     String // JSON: rule conditions
  assignToId     String?
  priority       Int          @default(0)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([isActive])
  @@index([organizationId])
  @@map("assignment_rules")
}

model Template {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  category       String // GREETING, ACKNOWLEDGMENT, FOLLOW_UP, etc.
  subject        String?
  body           String
  variables      String       @default("[]") // JSON: available variables
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@map("templates")
}

model UnmatchedEmail {
  id                String       @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  senderEmail       String
  senderName        String?
  subject           String
  bodyText          String
  bodyHtml          String?
  rawEmail          String?
  source            String? // Source: upwork, email, form, etc.
  suggestedClients  String? // JSON: AI suggestions
  suggestedProjects String? // JSON: AI suggestions
  status            String       @default("PENDING") // PENDING, RESOLVED, IGNORED
  resolvedAt        DateTime?
  createdAt         DateTime     @default(now())

  @@index([createdAt])
  @@index([senderEmail])
  @@index([organizationId])
  @@map("unmatched_emails")
}

model Lead {
  id                      String        @id @default(cuid())
  organizationId          String
  organization            Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  accountOwnerId          String
  accountOwner            User          @relation("LeadAccountOwner", fields: [accountOwnerId], references: [id], onDelete: Restrict)
  name                    String
  email                   String
  company                 String?
  phone                   String?
  serviceLine             String
  businessContext         String
  requestedOutcome        String
  timing                  String?
  budgetBand              String?
  budgetCurrency          String?
  status                  String        @default("NEW")
  qualificationNotes      String?
  qualificationReasonCode String?
  nextAction              String?
  nextActionDueAt         DateTime?
  qualifiedAt             DateTime?
  convertedClientId       String?
  convertedClient         Client?       @relation("LeadConvertedClient", fields: [convertedClientId], references: [id], onDelete: SetNull)
  convertedDealId         String?       @unique
  convertedDeal           PipelineDeal? @relation("LeadConvertedDeal", fields: [convertedDealId], references: [id], onDelete: SetNull)
  convertedAt             DateTime?
  source                  String?
  medium                  String?
  campaign                String?
  landingPage             String
  referrer                String?
  clickId                 String?
  consentVersion          String
  consentAt               DateTime
  intakeIdempotencyKey    String
  intakePayloadHash       String
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  events LeadEvent[]

  @@unique([organizationId, intakeIdempotencyKey])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, status, nextActionDueAt])
  @@index([organizationId, email])
  @@index([accountOwnerId, status])
  @@index([convertedClientId])
  @@index([convertedDealId])
  @@map("leads")
}

model LeadEvent {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leadId         String
  lead           Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  eventName      String
  properties     Json
  occurredAt     DateTime     @default(now())

  @@index([organizationId, eventName, occurredAt])
  @@index([leadId, occurredAt])
  @@map("lead_events")
}

model ChatMessage {
  id                 String    @id @default(cuid())
  content            String
  type               String    @default("TEXT") // TEXT, FILE, SYSTEM
  metadata           String? // JSON: file info, mentions, etc.
  externalSource     String? // e.g. SLACK; never treated as an Ashbi user
  externalAuthorName String?
  externalMessageId  String? // Provider-native message identifier for durable reconciliation
  externalThreadId   String? // Provider-native root-thread identifier
  isEdited           Boolean   @default(false)
  editedAt           DateTime?
  parentId           String? // For thread replies
  projectId          String
  authorId           String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Relations
  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author    User?          @relation("ChatAuthor", fields: [authorId], references: [id])
  parent    ChatMessage?   @relation("ChatReplies", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies   ChatMessage[]  @relation("ChatReplies")
  reactions ChatReaction[]

  @@index([projectId])
  @@index([projectId, createdAt])
  @@index([projectId, externalSource, externalMessageId])
  @@index([projectId, externalSource, externalThreadId])
  @@map("chat_messages")
}

model ChatReaction {
  id        String   @id @default(cuid())
  emoji     String
  messageId String
  userId    String
  createdAt DateTime @default(now())

  // Relations
  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id])

  @@unique([messageId, userId, emoji])
  @@map("chat_reactions")
}

model Note {
  id         String    @id @default(cuid())
  title      String
  content    String // Plain-text Markdown; clients must never render it as trusted HTML
  type       String    @default("NOTE") // NOTE, MEETING_NOTES, WIKI, DOC
  isPinned   Boolean   @default(false)
  tags       String    @default("[]") // JSON array of tags
  mentions   String    @default("[]") // JSON array of authorized mentioned user IDs
  isTemplate Boolean   @default(false)
  projectId  String
  authorId   String
  parentId   String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  // Soft delete
  deletedAt  DateTime?

  // Relations
  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author   User    @relation("NoteAuthor", fields: [authorId], references: [id])
  parent   Note?   @relation("NoteHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Note[]  @relation("NoteHierarchy")

  @@index([projectId, parentId])
  @@index([projectId, isTemplate])
  @@map("notes")
}

model Milestone {
  id          String    @id @default(cuid())
  name        String
  description String?
  dueDate     DateTime
  status      String    @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED, OVERDUE
  completedAt DateTime?
  color       String    @default("#3B82F6") // For visual distinction
  projectId   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  // Relations
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]  @relation("MilestoneTasks")

  @@map("milestones")
}

model TimeEntry {
  id              String    @id @default(cuid())
  description     String?
  duration        Int // Duration in minutes
  date            DateTime  @default(now())
  billable        Boolean   @default(true)
  hourlyRate      Float? // Override rate for this entry
  source          String    @default("MANUAL")
  invoiced        Boolean   @default(false) // Has this been included in an invoice?
  invoiceId       String? // Link to invoice if billed
  reviewStatus    String    @default("PENDING") // PENDING, APPROVED, REJECTED
  reviewedAt      DateTime?
  reviewedById    String?
  rejectionReason String?
  taskId          String?
  projectId       String
  userId          String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  // Soft delete
  deletedAt       DateTime?

  // Relations
  task    Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  project Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id])
  invoice Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([userId])
  @@index([invoiceId])
  @@index([reviewStatus])
  @@index([userId, date])
  @@map("time_entries")
}

model Attachment {
  id             String   @id @default(cuid())
  organizationId String
  filename       String
  originalName   String
  mimeType       String
  size           Int // Size in bytes
  path           String // Storage path or URL
  thumbnailPath  String? // For images
  entityType     String // PROJECT, TASK, CHAT, NOTE
