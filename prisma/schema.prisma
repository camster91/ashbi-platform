  createdAt      DateTime @default(now())

  site         WPSite       @relation(fields: [siteId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([siteId])
  @@index([siteUrl])
  @@index([timestamp])
  @@map("wp_backups")
}

// Monthly maintenance report delivered by the bridge plugin (v1.7.0+)
model WPReport {
  id             String   @id @default(cuid())
  organizationId String
  siteId         String
  siteUrl        String
  month          String
  uptime         String? // JSON: { total, ok, failed, pct }
  updates        String? // JSON: { plugins, themes, core }
  cleanup        String? // JSON: { revisions, spam_comments, trash_posts, expired_tokens }
  hours          String? // JSON: { available, used, remaining, banked, log }
  ssl            String? // JSON: { status, days }
  payload        String? // Full raw payload
  createdAt      DateTime @default(now())

  site         WPSite       @relation(fields: [siteId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([siteId, month])
  @@index([organizationId])
  @@index([siteUrl])
  @@index([createdAt])
  @@map("wp_reports")
}

// Support-hour alerts: new admin, promotions, security events (v1.7.0+)
model WPAlert {
  id             String   @id @default(cuid())
  organizationId String
  siteId         String?
  siteUrl        String
  alertType      String
  details        String   @default("{}")
  createdAt      DateTime @default(now())

  site         WPSite?      @relation(fields: [siteId], references: [id], onDelete: SetNull)
  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([siteUrl])
  @@index([alertType])
  @@index([createdAt])
  @@map("wp_alerts")
}

// Fleet ops audit log (Plan 7) — one row per hub-side fan-out call
// (file/patch, command, option/set). Records who ran what, how many sites
// were targeted, and how many succeeded/failed. Per-site results live in
// the wp_backups/wp_alerts tables the plugin already writes; this table is
// the hub-side orchestration ledger.
model WPFleetOp {
  id             String       @id @default(cuid())
  organizationId String
  opType         String // 'file_patch' | 'command' | 'option_set' | 'magic_login' | 'magic_login_revoke'
  payload        Json // original request body
  targetCount    Int
  successCount   Int          @default(0)
  failureCount   Int          @default(0)
  createdBy      String // user id from JWT
  createdAt      DateTime     @default(now())
  completedAt    DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([createdAt(sort: Desc)])
  @@index([opType])
  @@index([createdBy])
  @@map("wp_fleet_ops")
}

// Magic-login audit log (Plan 11 / PR-F).
//
// One row per state transition on a WP site: an issuance from the hub, a
// successful single-use consumption by an admin clicking the magic URL, an
// admin-initiated revocation, or a rejection (expired token, replay
// attempt, IP-blocked, rate-limited). Mirrors the per-site
// ashbi_magic_login_log wp_options ring buffer that the plugin keeps, but
// centralises the cross-site view so the WPSites "Recent Logins" tab can
// show fleet-wide activity in one place.
model WPMagicLoginLog {
  id             String       @id @default(cuid())
  organizationId String
  siteId         String? // nullable: pre-registration/wildcard logins may not have a row yet
  siteUrl        String // canonical site URL — survives WPSite deletes
  userId         Int? // WP user id (admin being issued for / logged in as)
  hubUserId      String? // hub user id (operator that triggered the issuance / revoke)
  ip             String       @default("0.0.0.0")
  status         String // 'issued' | 'consumed' | 'revoked' | 'rejected'
  reason         String? // 'expired_or_invalid' | 'replayed' | 'expired' | 'rate_limited' | 'ip_not_allowed' | 'manual_revoke'
  tokenHash      String? // sha256 of the raw magic-login token (NEVER the token itself)
  ts             DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([siteId])
  @@index([siteUrl])
  @@index([ts(sort: Desc)])
  @@index([status])
  @@map("wp_magic_login_log")
}

model WPBridgeNonce {
  id             String   @id @default(cuid())
  organizationId String
  siteId         String
  nonceHash      String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  site         WPSite       @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, nonceHash])
  @@index([organizationId, createdAt])
  @@index([createdAt])
  @@map("wp_bridge_nonces")
}
