  sentToEmail    String? // Recipient email address
  gmailMessageId String? // Gmail message ID for sent email
  gmailThreadId  String? // Gmail thread ID
  emailSentAt    DateTime? // When the email was sent
  emailContent   String? // JSON: { subject, body, cc, bcc }

  // Phase 3a: AI generation metadata
  aiGenerated Boolean @default(false)
  aiPrompt    String? // The prompt used for AI generation
  aiModel     String? // AI model that generated the content
  metadata    String? // JSON: flexible metadata for extensions

  client    Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project   Project?           @relation(fields: [projectId], references: [id])
  deal      PipelineDeal?      @relation(fields: [dealId], references: [id], onDelete: SetNull)
  createdBy User               @relation("ProposalCreator", fields: [createdById], references: [id])
  lineItems ProposalLineItem[]
  versions  ProposalVersion[]
  contract  Contract?
  // Soft delete
  deletedAt DateTime?

  // Autosave draft
  draftData String? // JSON of unsaved form data

  @@index([status])
  @@index([clientId, status])
  @@index([validUntil])
  @@map("proposals")
}

