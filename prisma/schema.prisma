model Proposal {
  id                    String    @id @default(cuid())
  title                 String
  status                String    @default("DRAFT") // DRAFT | SENT | VIEWED | APPROVED | DECLINED
  validUntil            DateTime?
  subtotal              Float     @default(0)
  discount              Float     @default(0)
  total                 Float     @default(0)
  currency              String? // CAD | USD; null means legacy currency evidence is unresolved
  notes                 String?
  internalNotes         String?
  viewToken             String?   @unique @default(cuid())
  publicAccessExpiresAt DateTime?
  publicAccessRevokedAt DateTime?
  approvedAt            DateTime?
  declinedAt            DateTime?
  sentAt                DateTime?
