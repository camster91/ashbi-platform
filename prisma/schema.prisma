// Durable reconciliation record for controlled Notion Markdown imports. The
// unique source key lets a rerun prove it is referring to the same export
// page, rather than guessing based on its title or current parent folder.
model NotionImportRecord {
  id             String   @id @default(cuid())
  organizationId String
  projectId      String
  noteId         String?
  sourceKey      String
  sourcePath     String
  contentSha256  String
  outcome        String   @default("IMPORTED") // IMPORTED, UNCHANGED, CONFLICT, SKIPPED
  lastError      String?
  importedAt     DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, sourceKey])
  @@index([organizationId, projectId])
  @@index([noteId])
  @@map("notion_import_records")
}

// Durable source-to-destination identity evidence for operating-data
// migrations. Source records from Notion and Bonsai remain independently
// addressable even when an approved decision resolves them to one Hub record.
// The polymorphic destination is deliberately represented by type + ID; import
// services must verify the tenant-owned destination before creating a record.
model OperatingSourceRecord {
  id                  String    @id @default(cuid())
  organizationId      String
  sourceSystem        String // NOTION | BONSAI
  entityType          String // PROJECT | TASK
  sourceId            String
  destinationId       String?
  outcome             String // IMPORTED | LINKED | RETAINED_SOURCE | EXCLUDED | REPAIR_REQUIRED
  sourceFingerprint   String
  decisionCandidateId String?
  decisionFingerprint String?
  importedAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, sourceSystem, entityType, sourceId])
  @@index([organizationId, entityType, destinationId])
  @@index([organizationId, outcome])
  @@map("operating_source_records")
}

// Human review state for evidence-bound Notion/Bonsai migration decisions.
// These records never apply a source link or mutate either source system;
// they preserve the bounded decision evidence used by a later migration plan.
model MigrationReviewPacket {
  id                    String   @id @default(cuid())
  organizationId        String
  kind                  String   // NOTION_BONSAI_PROJECT_LINK | NOTION_BONSAI_TASK_DISPOSITION
  importRequestId       String
  sourceReviewSha256    String
  mappingDecisionSha256 String
  supplementalSha256    String?
  sourcePreparedAt      DateTime
  sourceReview          Json
  mappingDecision       Json     // Project mapping decision or evidence dependency envelope
  supplementalEvidence  Json?
  reviewBrief           Json
  importedBy            String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  organization Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  decisions    MigrationReviewDecision[]

  @@unique([organizationId, importRequestId])
  @@unique([organizationId, kind, sourceReviewSha256])
  @@index([organizationId, createdAt])
  @@map("migration_review_packets")
}

// Immutable candidate-level decisions. A later event may supersede an older
// decision, while requestId makes each human action safe to retry exactly.
model MigrationReviewDecision {
  id             String   @id @default(cuid())
  organizationId String
  packetId       String
  requestId      String
  candidateId    String
  decision       String   // APPROVED | REJECTED
  reviewNote     String?
  reviewedBy     String
  decidedAt      DateTime @default(now())
  createdAt      DateTime @default(now())

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  packet       MigrationReviewPacket @relation(fields: [packetId], references: [id], onDelete: Cascade)

  @@unique([organizationId, requestId])
  @@index([organizationId, packetId, candidateId, decidedAt])
  @@map("migration_review_decisions")
}

