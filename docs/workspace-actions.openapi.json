    "/api/agent/tools/create_task": {
      "post": {
        "operationId": "create_task",
        "summary": "Create a task in a project. Prepares a preview only; requires confirm_action after human review.",
        "x-openai-isConsequential": true,
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "input": {
                    "type": "object",
                    "properties": {
                      "projectId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 50
                      },
                      "title": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 500
                      },
                      "description": {
                        "type": "string",
                        "maxLength": 10000
                      },
                      "priority": {
                        "type": "string",
                        "enum": [
                          "CRITICAL",
                          "HIGH",
                          "NORMAL",
                          "LOW"
                        ]
                      },
                      "dueDate": {
                        "type": "string",
                        "maxLength": 64
                      }
                    },
                    "required": [
                      "projectId",
                      "title"
                    ],
                    "additionalProperties": false
                  },
                  "idempotencyKey": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9._:-]{8,128}$"
                  }
                },
                "required": [
                  "input",
                  "idempotencyKey"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Structured result or action preview/receipt",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "additionalProperties": true
                    },
                    "meta": {
                      "type": "object",
                      "properties": {
                        "requestId": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "Request refused or operation failed; inspect error.code before retrying"
          }
        }
      }
    },
    "/api/agent/tools/create_calendar_event": {
      "post": {
        "operationId": "create_calendar_event",
        "summary": "Create an Ashbi calendar event in a project (never synced to an external calendar). Prepares a preview only; requires confirm_action after human review.",
        "x-openai-isConsequential": true,
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "input": {
                    "type": "object",
                    "properties": {
                      "projectId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 50
                      },
                      "title": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 500
                      },
                      "description": {
                        "type": "string",
                        "maxLength": 10000
                      },
                      "startTime": {
                        "type": "string",
                        "format": "date-time"
                      },
                      "endTime": {
                        "type": "string",
                        "format": "date-time"
                      },
                      "type": {
                        "type": "string",
                        "enum": [
                          "MEETING",
                          "DEADLINE",
                          "REMINDER",
                          "MILESTONE"
                        ]
                      },
                      "location": {
                        "type": "string",
                        "maxLength": 500
                      }
                    },
                    "required": [
                      "projectId",
                      "title",
                      "startTime",
                      "endTime"
                    ],
                    "additionalProperties": false
                  },
                  "idempotencyKey": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9._:-]{8,128}$"
                  }
                },
                "required": [
                  "input",
                  "idempotencyKey"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Structured result or action preview/receipt",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "additionalProperties": true
                    },
                    "meta": {
                      "type": "object",
                      "properties": {
                        "requestId": {
                          "type": "string"
                        }
