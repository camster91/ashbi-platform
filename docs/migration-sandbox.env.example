# Copy to /opt/ashbi-platform-migration-sandbox/.env, replace every required
# placeholder with a sandbox-only secret, and chmod 0600. Use alphanumeric
# database/Redis passwords so the connection URLs do not require URL encoding.
NODE_ENV=production
PORT=3002
APP_URL=http://localhost:13002
HUB_URL=http://localhost:13002
PORTAL_BASE_URL=http://localhost:13002
CORS_ORIGIN=http://localhost:13002
DATABASE_URL=postgresql://ashbi_sandbox:REPLACE_WITH_SANDBOX_DB_PASSWORD@postgres:5432/ashbi_sandbox?schema=public
REDIS_URL=redis://:REPLACE_WITH_SANDBOX_REDIS_PASSWORD@redis:6379
ASHBI_SANDBOX_DB_PASSWORD=REPLACE_WITH_SANDBOX_DB_PASSWORD
ASHBI_SANDBOX_REDIS_PASSWORD=REPLACE_WITH_SANDBOX_REDIS_PASSWORD

ASHBI_SANDBOX=true
ASHBI_SANDBOX_ENVIRONMENT_ID=ashbi-migration-sandbox
ASHBI_SANDBOX_ORGANIZATION_SLUG=ashbi-migration-sandbox
ASHBI_SANDBOX_ORGANIZATION_ID=
ASHBI_SANDBOX_STAFF_EMAIL=operator+sandbox@example.test
ASHBI_SANDBOX_STAFF_PASSWORD=REPLACE_WITH_SANDBOX_STAFF_PASSWORD
ASHBI_SANDBOX_CLIENT_EMAIL=client+sandbox@example.test
ASHBI_SANDBOX_BACKUP_REFERENCE=
ASHBI_SANDBOX_APPROVAL_REFERENCE=

JWT_SECRET=REPLACE_WITH_SANDBOX_JWT_SECRET
JWT_EXPIRES_IN=1d
ADMIN_INVITE_TOKEN=REPLACE_WITH_SANDBOX_ADMIN_INVITE_TOKEN
CREDENTIALS_KEY=REPLACE_WITH_SANDBOX_CREDENTIALS_KEY
CREDENTIALS_KEY_OWNER=Cameron
WEBHOOK_SECRET=REPLACE_WITH_SANDBOX_WEBHOOK_SECRET
WP_BRIDGE_SECRET=REPLACE_WITH_SANDBOX_WP_BRIDGE_SECRET
OBSERVABILITY_OWNER=Cameron

# Provider values stay blank for the migration-only phase. Configure a
# restricted test key, test webhook, and non-production Mailgun domain only
# after the separate provider-sandbox approval and exposure gate.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_SIGNING_KEY=

AI_PROVIDER=ollama
PUBLIC_INTAKE_ORGANIZATION_ID=
PUBLIC_INTAKE_OWNER_USER_ID=
PUBLIC_INTAKE_PRIVACY_VERSION=
PUBLIC_INTAKE_ALLOWED_ORIGINS=
SENTRY_DSN=
OTLP_ENDPOINT=
NOTIFICATION_WEBHOOK_URL=
