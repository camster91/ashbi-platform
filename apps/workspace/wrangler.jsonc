{
  "name": "ashbi-workspace",
  "main": "worker.mjs",
  "compatibility_date": "2026-07-30",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "APP_ORIGIN": "https://hub.ashbi.ca",
    "ACCESS_TEAM_DOMAIN": "https://camster91.cloudflareaccess.com",
    "ACCESS_AUD": "8e494036a6600cbf748527a570ab915df430785c4a4a3aba2442b21204c76441",
    "AUTH_MODE": "hub",
    "HUB_AUTH_ORGANIZATION_ID": "ecdfebe8-e53d-4d2d-a438-99ce5c209f23"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    },
    "redact_query_string": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ashbi-workspace",
      "database_id": "15dd758d-7871-4dd2-95bc-08600c5f8700",
      "migrations_dir": "migrations",
      "remote": false
    }
  ],
  "keep_vars": true,
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "ashbi-workspace-private",
      "remote": false
    }
  ],
  "routes": [
    {
      "pattern": "hub.ashbi.ca/*",
      "zone_name": "ashbi.ca"
    }
  ]
}
