{
  "name": "ashbi-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test auth.test.mjs test.mjs files.test.mjs time-details.test.mjs invoice-drafts.test.mjs invoice-recovery.test.mjs commercial.test.mjs proposal-reviews.test.mjs",
    "build": "wrangler deploy --dry-run --outdir dist",
    "dev": "wrangler dev --local --ip 127.0.0.1",
    "test:browser": "node browser.test.mjs",
    "test:invoice-built": "node --test invoice-drafts-built.test.mjs invoice-recovery-built.test.mjs commercial-built.test.mjs proposal-reviews-built.test.mjs"
  },
  "dependencies": {
    "jose": "6.2.12"
  },
  "devDependencies": {
    "axe-core": "4.14.0",
    "miniflare": "4.20260730.0",
    "playwright": "1.58.2",
    "wrangler": "4.152.0"
  }
}
