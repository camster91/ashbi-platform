{
    "name": "camster91/ashbi-agency-wp-bridge",
    "description": "Connects WordPress sites to hub.ashbi.ca for remote management.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "brain/monkey": "^2.6",
        "mockery/mockery": "^1.5",
        "phpstan/phpstan": "^1.10",
        "wp-coding-standards/wpcs": "^3.0",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "squizlabs/php_codesniffer": "^3.7"
    },
    "config": {
        "platform": {
            "php": "7.4"
        },
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "lint": "phpcs --standard=WordPress includes/ ashbi-agency-wp-bridge.php",
        "phpstan": "phpstan analyse --level=5 includes/",
        "test": "phpunit"
    }
}